PORT=6002
FRONTEND_URL=http://localhost:5173
# Primary: MongoDB Atlas (M0 free cluster).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/localkart
# Local fallback for development without Atlas:
# MONGO_URI=mongodb://127.0.0.1:27017/localkart
JWT_SECRET=replace-with-a-long-random-secret

# Required to send account verification codes via the Brevo HTTP API
# (Render blocks outbound SMTP). Free plan: 300 emails/day. The sender
# address must be verified in Brevo first (Settings -> Senders, Domains
# & Dedicated IPs -> Senders).
BREVO_API_KEY=<redacted>
BREVO_FROM=your-email@example.com

# Set this to lock the entire deployment to one university.
# When omitted, student accounts and listings are partitioned by the college
# name supplied during registration.
# CAMPUS_NAME=Your University

# Optional integrations:
# GEMINI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional development-only login password for generated demo sellers.
# Set this before running `npm run seed:demo`.
# DEMO_SEED_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
