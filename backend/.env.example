PORT=6002
MONGO_URI=mongodb://127.0.0.1:27017/localkart
JWT_SECRET=replace-with-a-long-random-secret

# Required to send account verification codes over SMTP.
# For Gmail, enable 2-Step Verification and use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-app-password
EMAIL_FROM=LocalKart <your-email@example.com>

# Set this to lock the entire deployment to one university.
# When omitted, student accounts and listings are partitioned by the college
# name supplied during registration.
# CAMPUS_NAME=Your University

# Optional integrations:
# GEMINI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional development-only login password for generated demo sellers.
# Set this before running `npm run seed:demo`.
# DEMO_SEED_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
